# Installed as /etc/lililo-bot.env with mode 0600.
# Keep the same OneBot token in NapCat's WebSocket client configuration.
LILILO_CONFIG=@PROJECT_DIR@/config.json
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# Only needed if WebUI listens on a non-loopback address.
# WEBUI_ACCESS_TOKEN=replace-with-another-long-random-token
